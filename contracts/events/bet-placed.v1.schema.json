{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bet-placed.v1.schema.json",
  "title": "BetPlacedEvent",
  "description": "theclub.bets.placed.v1 — se publica cuando el usuario coloca una apuesta, antes de resolver la ronda.",
  "allOf": [{ "$ref": "envelope.v1.schema.json" }],
  "properties": {
    "event_type": { "const": "bet.placed" },
    "data": { "$ref": "#/$defs/BetPlacedData" }
  },
  "$defs": {
    "BetPlacedData": {
      "type": "object",
      "required": [
        "round_id",
        "bet_id",
        "user_id",
        "bet_type",
        "selection",
        "stake_minor",
        "currency"
      ],
      "properties": {
        "round_id": { "type": "string", "format": "uuid" },
        "bet_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "bet_type": {
          "type": "string",
          "enum": [
            "straight", "split", "street", "corner", "line",
            "dozen", "column", "red", "black", "odd", "even", "high", "low"
          ]
        },
        "selection": {
          "type": "object",
          "description": "Forma variable según bet_type: {\"numbers\": [17]} para straight/split/street/corner/line, {\"index\": 1} para dozen/column (1-3), {} para red/black/odd/even/high/low."
        },
        "stake_minor": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string", "const": "EUR" }
      },
      "additionalProperties": false
    }
  }
}
