  "components": {
    "schemas": {
      "BalanceResponse": {
        "properties": {
          "balance_minor": {
            "type": "integer",
            "title": "Balance Minor"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "balance_minor",
          "currency"
        ],
        "title": "BalanceResponse"
      },
      "BetInput": {
        "properties": {
          "bet_type": {
            "$ref": "#/components/schemas/BetType"
          },
          "selection": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                }
              ]
            },
            "type": "object",
            "title": "Selection"
          },
          "stake_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Stake Minor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bet_type",
          "selection",
          "stake_minor"
        ],
        "title": "BetInput"
      },
      "BetType": {
        "type": "string",
        "enum": [
          "straight",
          "split",
          "street",
          "corner",
          "line",
          "dozen",
          "column",
          "red",
          "black",
          "odd",
          "even",
          "high",
          "low"
        ],
        "title": "BetType"
      },
      "DepositRequest": {
        "properties": {
          "amount_minor": {
            "type": "integer",
            "maximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_minor"
        ],
        "title": "DepositRequest"
      },
      "DepositResponse": {
        "properties": {
          "balance_minor": {
            "type": "integer",
            "title": "Balance Minor"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "balance_minor",
          "currency"
        ],
        "title": "DepositResponse"
      },
      "FairnessCurrentResponse": {
        "properties": {
          "server_seed_hash": {
            "type": "string",
            "title": "Server Seed Hash"
          },
          "client_seed": {
            "type": "string",
            "title": "Client Seed"
          },
          "nonce": {
            "type": "integer",
            "title": "Nonce"
          }
        },
        "type": "object",
        "required": [
          "server_seed_hash",
          "client_seed",
          "nonce"
        ],
        "title": "FairnessCurrentResponse"
      },
      "FairnessRotateResponse": {
        "properties": {
          "revealed_server_seed": {
            "type": "string",
            "title": "Revealed Server Seed"
          },
          "revealed_server_seed_hash": {
            "type": "string",
            "title": "Revealed Server Seed Hash"
          },
          "new_server_seed_hash": {
            "type": "string",
            "title": "New Server Seed Hash"
          },
          "new_client_seed": {
            "type": "string",
            "title": "New Client Seed"
          }
        },
        "type": "object",
        "required": [
          "revealed_server_seed",
          "revealed_server_seed_hash",
          "new_server_seed_hash",
          "new_client_seed"
        ],
        "title": "FairnessRotateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "env": {
            "type": "string",
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "status",
          "name",
          "version",
          "env"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PlaceRoundRequest": {
        "properties": {
          "bets": {
            "items": {
              "$ref": "#/components/schemas/BetInput"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Bets"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bets"
        ],
        "title": "PlaceRoundRequest"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "RoundHistoryItem": {
        "properties": {
          "round_id": {
            "type": "string",
            "format": "uuid",
            "title": "Round Id"
          },
          "outcome": {
            "type": "integer",
            "title": "Outcome"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "bets": {
            "items": {
              "$ref": "#/components/schemas/SettledBetResponse"
            },
            "type": "array",
            "title": "Bets"
          }
        },
        "type": "object",
        "required": [
          "round_id",
          "outcome",
          "created_at",
          "bets"
        ],
        "title": "RoundHistoryItem"
      },
      "RoundHistoryPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RoundHistoryItem"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "RoundHistoryPage"
      },
      "RoundResponse": {
        "properties": {
          "round_id": {
            "type": "string",
            "format": "uuid",
            "title": "Round Id"
          },
          "outcome": {
            "type": "integer",
            "title": "Outcome"
          },
          "bets": {
            "items": {
              "$ref": "#/components/schemas/SettledBetResponse"
            },
            "type": "array",
            "title": "Bets"
          },
          "total_stake_minor": {
            "type": "integer",
            "title": "Total Stake Minor"
          },
          "total_payout_minor": {
            "type": "integer",
            "title": "Total Payout Minor"
          },
          "net_minor": {
            "type": "integer",
            "title": "Net Minor"
          },
          "balance_minor": {
            "type": "integer",
            "title": "Balance Minor"
          }
        },
        "type": "object",
        "required": [
          "round_id",
          "outcome",
          "bets",
          "total_stake_minor",
          "total_payout_minor",
          "net_minor",
          "balance_minor"
        ],
        "title": "RoundResponse"
      },
      "SettledBetResponse": {
        "properties": {
          "bet_type": {
            "$ref": "#/components/schemas/BetType"
          },
          "selection": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                }
              ]
            },
            "type": "object",
            "title": "Selection"
          },
          "stake_minor": {
            "type": "integer",
            "title": "Stake Minor"
          },
          "payout_minor": {
            "type": "integer",
            "title": "Payout Minor"
          },
          "won": {
            "type": "boolean",
            "title": "Won"
          }
        },
        "type": "object",
        "required": [
          "bet_type",
          "selection",
          "stake_minor",
          "payout_minor",
          "won"
        ],
        "title": "SettledBetResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenResponse"
      },
      "TransactionItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "amount_minor": {
            "type": "integer",
            "title": "Amount Minor"
          },
          "balance_after_minor": {
            "type": "integer",
            "title": "Balance After Minor"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "ref_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref Type"
          },
          "ref_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
