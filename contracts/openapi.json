    "/api/v1/wallet/deposit": {
      "post": {
        "tags": [
          "wallet"
        ],
        "summary": "Deposit",
        "operationId": "deposit_api_v1_wallet_deposit_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
