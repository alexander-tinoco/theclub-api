# Copia este archivo a .env y ajusta lo que necesites.
# En local todos los valores tienen defaults sensatos: puedes arrancar sin .env.

# --- puertos que docker-compose publica en el host ---
# Cámbialos si alguno ya está ocupado por otro proyecto tuyo.
API_PORT=8010
CONSOLE_PORT=8090
POSTGRES_PORT=5432
KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDIS_PORT=6389

# --- aplicación ---
APP_ENV=local
APP_NAME=theclub-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- base de datos (Fase 3) ---
# Desde el host usa localhost; dentro de docker-compose el host es `postgres`.
DATABASE_URL=postgresql+psycopg://theclub:theclub@localhost:5432/theclub
DB_POOL_SIZE=5

# --- Redis (Fase 8) ---
# Estado del rate limiting (global y de /ws). Desde el host: localhost:6389.
# Dentro de docker-compose el host es `redis` y el puerto real es 6379.
REDIS_URL=redis://localhost:6389/0

# --- Kafka / Redpanda (Fase 6) ---
# Desde el host: localhost:19092. Dentro de compose: redpanda:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_PREFIX=theclub
# Solo para Confluent Cloud u otro broker gestionado:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- autenticación (Fase 4) ---
# Fuera de local/test la app NO arranca con este valor ni con menos de 32 caracteres.
JWT_SECRET=cambiame-en-produccion-000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- juego y outbox (Fases 5 y 6) ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_RETENTION_HOURS=168
OUTBOX_CLEANUP_INTERVAL_S=3600
TABLE_MIN_BET_MINOR=100
TABLE_MAX_BET_MINOR=500000

# --- WebSocket (Fase 7) ---
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL_S=20
WS_HEARTBEAT_TIMEOUT_S=45
WS_CONNECT_RATE_LIMIT_ATTEMPTS=10
WS_CONNECT_RATE_LIMIT_WINDOW_S=60

# --- endurecimiento (Fase 8) ---
MAX_REQUEST_BODY_BYTES=1000000
