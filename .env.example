# Copy this file to .env and adjust what you need.
# Locally every value has a sane default: you can start up without a .env.

# --- ports docker-compose publishes on the host ---
# Change any of these if it's already taken by another project of yours.
API_PORT=8010
CONSOLE_PORT=8090
POSTGRES_PORT=5432
KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDIS_PORT=6389
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# --- application ---
APP_ENV=local
APP_NAME=theclub-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- database (Phase 3) ---
# From the host, use localhost; inside docker-compose the host is `postgres`.
DATABASE_URL=postgresql+psycopg://theclub:theclub@localhost:5432/theclub
DB_POOL_SIZE=5

# --- Redis (Phase 8) ---
# Rate limiting state (global and /ws). From the host: localhost:6389.
# Inside docker-compose the host is `redis` and the real port is 6379.
REDIS_URL=redis://localhost:6389/0

# --- Kafka / Redpanda (Phase 6) ---
# From the host: localhost:19092. Inside compose: redpanda:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_PREFIX=theclub
# Only for Confluent Cloud or another managed broker:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- authentication (Phase 4) ---
# Outside local/test the app will NOT start with this value or with fewer than 32 characters.
JWT_SECRET=change-me-in-production-000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# When rotating JWT_SECRET, the old value moves here (CSV if there's more than one)
# so already-issued access tokens keep validating until they expire.
# Remove it once ACCESS_TOKEN_TTL_SECONDS has passed since the rotation.
# JWT_PREVIOUS_SECRETS=

# --- game and outbox (Phases 5 and 6) ---
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_RETENTION_HOURS=168
OUTBOX_CLEANUP_INTERVAL_S=3600
TABLE_MIN_BET_MINOR=100
TABLE_MAX_BET_MINOR=500000

# --- WebSocket (Phase 7) ---
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL_S=20
WS_HEARTBEAT_TIMEOUT_S=45
WS_CONNECT_RATE_LIMIT_ATTEMPTS=10
WS_CONNECT_RATE_LIMIT_WINDOW_S=60

# --- hardening (Phase 8) ---
MAX_REQUEST_BODY_BYTES=1000000
